Name: wplink-api
RuntimeMode: production
Host: 127.0.0.1
Port: 4000

Log:
  Mode: "file"
  Encoding: "json"
  Path: "logs"
  Level: "info"
  Rotation: "daily"
  KeepDays: 7
  Compress: false
  Stat: true

Postgres:
  DSN: "${DATABASE_URL}"
  MaxOpenConns: 30
  MaxIdleConns: 10
  ConnMaxLifetime: 30m
  ConnMaxIdleTime: 5m

AdminAuth:
  TokenSecret: "${ADMIN_TOKEN_SECRET}"
  TokenTTL: 24h

UserAuth:
  TokenSecret: "${USER_TOKEN_SECRET}"
  TokenTTL: 24h

Wechat:
  AppID: "${WECHAT_APP_ID}"
  AppSecret: "${WECHAT_APP_SECRET}"
  AllowDevCode: false

TencentMap:
  Key: "${TENCENT_MAP_KEY}"
  RequestTimeout: 5s

ContentAudit:
  Enabled: true
  TextScene: 3
  # 微信图片审核为异步回调能力，请在微信后台配置回调到 /api/v1/wechat/content-audit/media-callback。
  MediaEnabled: true
  MediaScene: 3
  RequestTimeout: 5s
  MaxTextChars: 2500
  CallbackToken: "${WECHAT_CONTENT_AUDIT_CALLBACK_TOKEN}"
  CallbackMaxSkew: 5m

WechatPay:
  Enabled: false
  DevMockEnabled: false
  MchID: "${WECHAT_PAY_MCH_ID}"
  AppID: "${WECHAT_APP_ID}"
  APIv3Key: "${WECHAT_PAY_API_V3_KEY}"
  MerchantSerialNo: "${WECHAT_PAY_MERCHANT_SERIAL_NO}"
  MerchantPrivateKeyPath: "${WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH}"
  PlatformPublicKeyPath: "${WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH}"
  NotifyURL: "${WECHAT_PAY_NOTIFY_URL}"
  RequestTimeout: 10s
  OrderExpire: 30m

SMS:
  Provider: "http"
  SendURL: "${SMS_SEND_URL}"
  VerifyURL: "${SMS_VERIFY_URL}"
  SendMinInterval: 60s
  DailySendLimit: 10
  AccessKeyID: "${SMS_ACCESS_KEY_ID}"
  AccessKeySecret: "${SMS_ACCESS_KEY_SECRET}"
  SignName: "${SMS_SIGN_NAME}"
  TemplateCode: "${SMS_TEMPLATE_CODE}"
  DevCode: ""

Tasks:
  ResourceLifecycleInterval: 1h
  ContentAuditRetryInterval: 1m
  ContentAuditRetryBatchSize: 20
  # 地图行为属于低优先级分析数据，每日清理并只保留最近 90 天。
  MerchantMapEventCleanupInterval: 24h
  MerchantMapEventRetentionDays: 90
  PaymentReconcileInterval: 1m
  PaymentQueryDelay: 2m
  PaymentBatchSize: 100

Storage:
  Provider: "qiniu-kodo"
  Endpoint: "${QINIU_UPLOAD_ENDPOINT}"
  Bucket: "${QINIU_BUCKET}"
  Region: "${QINIU_REGION}"
  AccessKeyID: "${QINIU_ACCESS_KEY}"
  AccessKeySecret: "${QINIU_SECRET_KEY}"
  PublicBaseURL: "${QINIU_PUBLIC_BASE_URL}"
  UploadExpire: 15m
  MaxFileSizeBytes: 10485760
  AllowedContentTypes:
    - "image/jpeg"
    - "image/png"
    - "image/webp"
