syntax = "v1"

type VIPBenefitInfo {
	PublishPolicy      string `json:"publishPolicy"`
	PublishQuota       int64  `json:"publishQuota"`
	RefreshQuota       int64  `json:"refreshQuota"`
	TopVoucherCount    int64  `json:"topVoucherCount"`
	TopDurationHours   int64  `json:"topDurationHours"`
	HomepageImageLimit int64  `json:"homepageImageLimit,optional"`
}

type VIPPlanInfo {
	Code              string         `json:"code"`
	Name              string         `json:"name"`
	DurationMonths    int64          `json:"durationMonths"`
	StandardPriceCent int64          `json:"standardPriceCent"`
	SalePriceCent     int64          `json:"salePriceCent,optional"`
	SaleLabel         string         `json:"saleLabel,optional"`
	Benefits          VIPBenefitInfo `json:"benefits"`
}

type ListVIPPlansResp {
	Items []VIPPlanInfo `json:"items"`
}

type QuotaPackInfo {
	Code              string         `json:"code"`
	Name              string         `json:"name"`
	Description       string         `json:"description"`
	StandardPriceCent int64          `json:"standardPriceCent"`
	SalePriceCent     int64          `json:"salePriceCent,optional"`
	SaleLabel         string         `json:"saleLabel,optional"`
	Benefits          VIPBenefitInfo `json:"benefits"`
}

type ListQuotaPacksResp {
	Items []QuotaPackInfo `json:"items"`
}

type MerchantVIPResp {
	MerchantId            string `json:"merchantId"`
	Status                string `json:"status"`
	PlanCode              string `json:"planCode,optional"`
	PlanName              string `json:"planName,optional"`
	StartsAt              string `json:"startsAt,optional"`
	ExpiresAt             string `json:"expiresAt,optional"`
	PublishQuotaRemaining int64  `json:"publishQuotaRemaining"`
	RefreshQuotaRemaining int64  `json:"refreshQuotaRemaining"`
	TopVoucherCount       int64  `json:"topVoucherCount"`
}

type CreateVIPOrderReq {
	ProductType string `json:"productType,optional"`
	ProductCode string `json:"productCode,optional"`
	PlanCode    string `json:"planCode,optional"`
	ResourceId  string `json:"resourceId,optional"`
}

type CreateVIPOrderResp {
	OrderId           string         `json:"orderId"`
	Status            string         `json:"status"`
	ProductType       string         `json:"productType,optional"`
	ProductCode       string         `json:"productCode,optional"`
	ProductName       string         `json:"productName,optional"`
	PlanCode          string         `json:"planCode,optional"`
	PlanName          string         `json:"planName,optional"`
	StandardPriceCent int64          `json:"standardPriceCent"`
	ActualPriceCent   int64          `json:"actualPriceCent"`
	PromotionCode     string         `json:"promotionCode,optional"`
	Benefits          VIPBenefitInfo `json:"benefits"`
}

type CreateVIPPaymentReq {}

// WechatPayParams 是 VIP 与供需联系方式解锁共用的微信支付调起参数。
type WechatPayParams {
	TimeStamp string `json:"timeStamp"`
	NonceStr  string `json:"nonceStr"`
	Package   string `json:"package"`
	SignType  string `json:"signType"`
	PaySign   string `json:"paySign"`
}

type CreateVIPPaymentResp {
	OrderId string          `json:"orderId"`
	Status  string          `json:"status"`
	Payment WechatPayParams `json:"payment"`
}

@server (
	prefix: /api/v1
	group:  vip
)
service wplink-api {
	@handler ListVIPPlans
	get /vip/plans returns (ListVIPPlansResp)

	@handler ListQuotaPacks
	get /vip/quota-packs returns (ListQuotaPacksResp)

	@handler GetMerchantVIP
	get /merchants/:merchantId/vip returns (MerchantVIPResp)

	@handler CreateVIPOrder
	post /merchants/:merchantId/vip/orders (CreateVIPOrderReq) returns (CreateVIPOrderResp)

	@handler CreateVIPPayment
	post /merchants/:merchantId/vip/orders/:orderId/payment (CreateVIPPaymentReq) returns (CreateVIPPaymentResp)
}
