syntax = "v1"

type CreditTagInfo {
	Code  string `json:"code"`
	Label string `json:"label"`
}

type MerchantContactInfo {
	Name         string `json:"name,optional"`
	Phone        string `json:"phone,optional"`
	Wechat       string `json:"wechat,optional"`
	PhoneMasked  string `json:"phoneMasked,optional"`
	WechatMasked string `json:"wechatMasked,optional"`
}

type MerchantResourcesSummary {
	PublishedCount int64 `json:"publishedCount"`
	DealtCount     int64 `json:"dealtCount"`
}

type MerchantLocationInfo {
	MarketName   string  `json:"marketName,optional"`
	BuildingName string  `json:"buildingName,optional"`
	FloorNo      string  `json:"floorNo,optional"`
	BoothNo      string  `json:"boothNo,optional"`
	Latitude     float64 `json:"latitude,optional"`
	Longitude    float64 `json:"longitude,optional"`
	LocationName string  `json:"locationName,optional"`
	Status       string  `json:"status"`
	UpdatedAt    string  `json:"updatedAt,optional"`
	Available    bool    `json:"available"`
}

type BusinessProfileInfo {
	SchemaVersion     int      `json:"schemaVersion"`
	EntityKind        string   `json:"entityKind"`
	PrimaryRole       string   `json:"primaryRole"`
	Roles             []string `json:"roles"`
	ServiceArea       string   `json:"serviceArea"`
	ProcessingMethods []string `json:"processingMethods"`
	PropertyTypes     []string `json:"propertyTypes"`
	ServiceItems      []string `json:"serviceItems"`
}

type BusinessProfileInput {
	SchemaVersion     int      `json:"schemaVersion"`
	EntityKind        string   `json:"entityKind"`
	PrimaryRole       string   `json:"primaryRole"`
	Roles             []string `json:"roles"`
	ServiceArea       string   `json:"serviceArea,optional"`
	ProcessingMethods []string `json:"processingMethods,optional"`
	PropertyTypes     []string `json:"propertyTypes,optional"`
	ServiceItems      []string `json:"serviceItems,optional"`
}

type MerchantDetailResp {
	Id                 string                   `json:"id"`
	MerchantNo         string                   `json:"merchantNo"`
	Name               string                   `json:"name"`
	MerchantType       string                   `json:"merchantType"`
	CityCode           string                   `json:"cityCode"`
	MainCategories     []string                 `json:"mainCategories"`
	ProfileStatus      string                   `json:"profileStatus"`
	VipStatus          string                   `json:"vipStatus"`
	CreditTags         []CreditTagInfo          `json:"creditTags"`
	Contact            *MerchantContactInfo     `json:"contact,optional"`
	ResourcesSummary   MerchantResourcesSummary `json:"resourcesSummary"`
	HeatScore          int64                    `json:"heatScore"`
	AddressText        string                   `json:"addressText,optional"`
	Location           MerchantLocationInfo     `json:"location"`
	Description        string                   `json:"description,optional"`
	LogoUrl            string                   `json:"logoUrl,optional"`
	Images             []string                 `json:"images,optional"`
	LastActiveAt       string                   `json:"lastActiveAt,optional"`
	OwnerVisible       bool                     `json:"ownerVisible"`
	PublicPhone        bool                     `json:"publicPhone"`
	PublicWechat       bool                     `json:"publicWechat"`
	BusinessProfile    BusinessProfileInfo      `json:"businessProfile"`
	MapVisible         bool                     `json:"mapVisible"`
}

type UpdateMerchantReq {
	Name           string                 `json:"name,optional"`
	MainCategories []string               `json:"mainCategories,optional"`
	Description    string                 `json:"description,optional"`
	LogoUrl        string                 `json:"logoUrl,optional"`
	Images         []string               `json:"images,optional"`
	ContactName    string                 `json:"contactName,optional"`
	ContactPhone   string                 `json:"contactPhone,optional"`
	ContactWechat  string                 `json:"contactWechat,optional"`
	AddressText    string                 `json:"addressText,optional"`
	LocationAction string                 `json:"locationAction"`
	MarketName     string                 `json:"marketName,optional"`
	BuildingName   string                 `json:"buildingName,optional"`
	FloorNo        string                 `json:"floorNo,optional"`
	BoothNo        string                 `json:"boothNo,optional"`
	Latitude       float64                `json:"latitude,optional"`
	Longitude      float64                `json:"longitude,optional"`
	LocationName   string                 `json:"locationName,optional"`
	SmsCode        string                 `json:"smsCode,optional"`
	PublicPhone    *bool                  `json:"publicPhone,optional"`
	PublicWechat   *bool                  `json:"publicWechat,optional"`
	BusinessProfile *BusinessProfileInput  `json:"businessProfile"`
	MapVisible     *bool                  `json:"mapVisible"`
}

type SetMerchantVisibilityReq {
	Visible *bool `json:"visible"`
}

type SetMerchantVisibilityResp {
	MerchantId   string `json:"merchantId"`
	OwnerVisible bool   `json:"ownerVisible"`
}

type UpdateMerchantResp {
	Id        string `json:"id"`
	UpdatedAt string `json:"updatedAt"`
}

type ListMerchantDirectoryReq {
	CityCode  string `form:"cityCode,optional"`
	Keyword   string `form:"keyword,optional"`
	Categories string `form:"categories,optional"`
	Page      int64  `form:"page,optional"`
	PageSize  int64  `form:"pageSize,optional"`
}

// MerchantDirectoryItem 只定义公开目录字段，不得加入联系人、电话或微信。
type MerchantDirectoryItem {
	MerchantId           string   `json:"merchantId"`
	MerchantNo           string   `json:"merchantNo"`
	Name                 string   `json:"name"`
	MerchantType         string   `json:"merchantType"`
	MainCategories       []string `json:"mainCategories"`
	LogoUrl              string   `json:"logoUrl,optional"`
	AddressText          string   `json:"addressText,optional"`
	MarketName           string   `json:"marketName,optional"`
	BuildingName         string   `json:"buildingName,optional"`
	FloorNo              string   `json:"floorNo,optional"`
	BoothNo              string   `json:"boothNo,optional"`
	Latitude             float64  `json:"latitude"`
	Longitude            float64  `json:"longitude"`
	LocationName         string   `json:"locationName,optional"`
	LastResourceActiveAt string   `json:"lastResourceActiveAt,optional"`
	DistanceMeters       float64  `json:"distanceMeters,optional"`
	PrimaryRole          string   `json:"primaryRole,optional"`
	BusinessRoles        []string `json:"businessRoles,optional"`
}

type ListMerchantDirectoryResp {
	Items    []MerchantDirectoryItem `json:"items"`
	Total    int64                   `json:"total"`
	Page     int64                   `json:"page"`
	PageSize int64                   `json:"pageSize"`
}

type MerchantDirectoryLocationContextResp {
	Current         MerchantDirectoryItem   `json:"current"`
	Nearby          []MerchantDirectoryItem `json:"nearby"`
	RadiusMeters    int64                   `json:"radiusMeters"`
	NearbyAvailable bool                    `json:"nearbyAvailable"`
}

type CreateMerchantLocationReportReq {
	ReasonCode  string `json:"reasonCode"`
	Description string `json:"description,optional"`
}

type CreateMerchantLocationReportResp {
	ReportId            string `json:"reportId"`
	Status              string `json:"status"`
	ActiveReporterCount int64  `json:"activeReporterCount"`
	AutoHidden          bool   `json:"autoHidden"`
	Idempotent          bool   `json:"idempotent"`
}

@server (
	prefix: /api/v1
	group:  merchant
)
service wplink-api {
	@handler ListMerchantDirectory
	get /merchant-directory (ListMerchantDirectoryReq) returns (ListMerchantDirectoryResp)

	@handler GetMerchant
	get /merchants/:merchantId returns (MerchantDetailResp)

	@handler GetMerchantLocationContext
	get /merchants/:merchantId/location-context returns (MerchantDirectoryLocationContextResp)

	@handler CreateMerchantLocationReport
	post /merchants/:merchantId/location-reports (CreateMerchantLocationReportReq) returns (CreateMerchantLocationReportResp)

	@handler UpdateMerchant
	post /merchants/:merchantId (UpdateMerchantReq) returns (UpdateMerchantResp)

	@handler SetMerchantVisibility
	post /merchants/:merchantId/visibility (SetMerchantVisibilityReq) returns (SetMerchantVisibilityResp)
}
